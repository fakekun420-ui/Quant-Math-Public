# Quant-Math — Bybit API credentials
# Copy to .env and fill with your keys. Never commit .env.
# chmod 600 .env

# Bybit (https://www.bybit.com/app/user/api-management)
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true = Bybit Testnet (sandbox) — use for testing; false = Mainnet futures USDT perpetuals
BYBIT_TESTNET=true

# Optional overrides
# BYBIT_API_PASSPHRASE=
